[core]
	excludesfile = ~/.gitignore_global
	abbrev = 12
[commit]
	verbose = true
[user]
	name = Andrew Neitsch
	email = andrew@neitsch.ca
[push]
	default = current
[color]
	ui = auto
[gc]
	reflogExpireUnreachable = 36524
	reflogExpire = 36524
[alias]
	current-branch = !git branch | grep ^* | cut -c3-
	amend-now = !env GIT_AUTHOR_DATE=$(date +%s) \
		GIT_COMMITTER_DATE=$(date +%s) \
		git commit --amend
	word-color-diff = diff --word-diff=color
	commit = commit -S
	history = log -g --abbrev-commit --pretty=oneline 'HEAD@{now}'

[format]
	pretty = format:%C(auto,yellow)%H%C(auto,reset) tree %t%n%an <%ae> %G? %GS%n%ai   parents %p%n%n%B

[diff]
	compactionHeuristic = true
