#!/usr/bin/env python3

import json
import plistlib
from pathlib import Path

IBOOKS_PATH = Path(
    "~/Library/Containers/com.apple.BKAgentService/Data/Documents/iBooks/Books"
).expanduser()


def main():
    for epub_dir in IBOOKS_PATH.glob("*.epub"):
        f = epub_dir / "iTunesMetadata.plist"
        if not f.exists():
            print(f"warning: no metadata in {epub_dir}")
            continue

        with f.open("rb") as f:
            data = plistlib.load(f)

            for k in ["BKDisplayName", "itemName"]:
                if k in data:
                    print(f"{epub_dir}: {data[k]}")
                    break
            else:
                print(json.dumps(data, indent=2))


if __name__ == "__main__":
    main()
