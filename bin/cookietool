#!/usr/bin/env python3
import http.cookiejar
from argparse import ArgumentParser
from http.cookiejar import FileCookieJar, MozillaCookieJar, Cookie
from pathlib import Path


def add(args):
    jar = MozillaCookieJar(args.cookie_file)
    try:
        jar.load()
    except FileNotFoundError:
        pass

    c = Cookie(
        version=0,
        name=args.name,
        value=args.value,
        port=None,
        port_specified=False,
        domain=args.domain,
        domain_specified=True,
        domain_initial_dot=True,
        path="/",
        path_specified=True,
        secure=True,
        expires=None,
        discard=False,
        comment=None,
        comment_url=None,
        rest={},
    )
    jar.set_cookie(c)
    jar.save()


def main():
    parser = ArgumentParser(allow_abbrev=False)
    parser.add_argument(
        "--cookie-file", default="cookies.txt", help="Where to store cookies"
    )

    subparser = parser.add_subparsers(required=True)

    add_parser = subparser.add_parser("add")
    add_parser.set_defaults(command_func=add)
    add_parser.add_argument("--domain", required=True)
    add_parser.add_argument("--name", required=True)
    add_parser.add_argument("--value", required=True)

    args = parser.parse_args()
    args.command_func(args)


if __name__ == "__main__":
    main()
