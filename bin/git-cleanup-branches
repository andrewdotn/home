#!/usr/bin/env python

__doc__ = """
Delete branches, both locally and on the given remote, that have been
merged to the current branch.
"""

# https://stackoverflow.com/questions/3846380/how-to-iterate-through-all-git-branches-using-bash-script

from subprocess import check_call, check_output
from argparse import ArgumentParser


def main():
    parser = ArgumentParser(description=__doc__)
    parser.add_argument("remote")
    args = parser.parse_args()

    current_branch = (
        check_output(["git", "branch", "--show-current"])
        .decode("utf-8")
        .strip()
    )

    ref_and_upstream = (
        check_output(
            [
                "git",
                "for-each-ref",
                "--format",
                "%(refname) %(upstream)",
                "refs/heads",
                "--merged",
            ]
        )
        .decode("utf-8")
        .strip()
    )

    local_branches_to_delete = []
    remote_branches_to_delete = []

    for line in ref_and_upstream.split("\n"):
        if not line.strip():
            continue
        pieces = line.split()
        if len(pieces) != 2:
            continue

        branch_ref, remote_ref = pieces

        branch_name = branch_ref.removeprefix("refs/heads/")
        if branch_name in ["main", "master", current_branch]:
            continue

        remote_ref = remote_ref.removeprefix("refs/remotes/")
        if remote_ref.startswith(args.remote):
            remote_ref = remote_ref.removeprefix(args.remote + "/")
        else:
            continue

        local_branches_to_delete.append(branch_name)
        remote_branches_to_delete.append(remote_ref)

    if remote_branches_to_delete:
        cmd = ["git", "push", "-d", args.remote] + remote_branches_to_delete
        print(cmd)
        check_call(cmd)
    if local_branches_to_delete:
        cmd = ["git", "branch", "-d"] + local_branches_to_delete
        print(cmd)
        check_call(cmd)


if __name__ == "__main__":
    main()
