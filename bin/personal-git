#!/usr/bin/env python2.7

import os
import sys

env_vars = {
    'GIT_AUTHOR_NAME': 'Andrew Neitsch',
    'GIT_COMMITTER_NAME': 'Andrew Neitsch',
    'GIT_AUTHOR_EMAIL': 'andrew@neitsch.ca',
    'GIT_COMMITTER_EMAIL': 'andrew@neitsch.ca',
}

for k, v in env_vars.items():
    os.environ[k] = v

args = sys.argv[1:]
if args[0] == 'commit':
    args.insert(1, '--no-gpg-sign')

os.execvp('git', ['git'] + args)
